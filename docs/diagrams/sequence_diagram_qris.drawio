        <mxCell id="act9" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="mid">
          <mxGeometry x="45" y="610" width="10" height="800" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="1. Pilih Paket Pro &amp; Klik 'Bayar QRIS'" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0621;entryX=0;entryY=0.0;" edge="1" parent="1" source="u" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="2. POST /api/payments/qris/charge (JWT auth)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.119;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="3. Validasi Zod &amp; Generate order_id unik" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1562;entryX=1;entryY=0.25;" edge="1" parent="1" source="act2" target="act2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="610" y="230"/><mxPoint x="610" y="260"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="4. POST /v2/charge (Server-Key, type: qris)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.375;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="5. 200 OK (qr_string, expire_time 15m)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.5312;" edge="1" parent="1" source="act0" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="6. INSERT INTO transactions (status: 'pending')" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6875;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="7. Transaksi Pending Tersimpan" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8438;" edge="1" parent="1" source="act1" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="8. 201 Created { qr_string, order_id, expires_at }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.881;" edge="1" parent="1" source="act2" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="9. Render QR Code Interaktif &amp; Timer" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.3517;" edge="1" parent="1" source="act3" target="u">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="10. Polling Status: GET /qris/:id/status (loop 3s)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.3862;entryX=0;entryY=0.0;" edge="1" parent="1" source="fe" target="act6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="11. Scan QRIS &amp; Transfer Dana via E-Wallet" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4207;entryX=0;entryY=0.0;" edge="1" parent="1" source="u" target="act9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note11" value="Dua Jalur Penyelesaian: Webhook (A) dan Polling Otoritatif (B)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="680" width="170" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="12. POST /api/payments/midtrans/notification (Jalur A)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0;exitY=0.1375;entryX=1;entryY=0.3333;" edge="1" parent="1" source="act9" target="act6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m13" value="13. Verifikasi SHA-512 Signature &amp; timingSafeEqual" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4375;entryX=1;entryY=0.5;" edge="1" parent="1" source="act6" target="act6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="610" y="810"/><mxPoint x="610" y="840"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m14" value="14. UPDATE transactions SET status='success' WHERE id=? AND status='pending' (CAS)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.5833;entryX=0;entryY=0.0;" edge="1" parent="1" source="act6" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m15" value="15. Rows affected = 1 (Klaim Berhasil)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.6875;" edge="1" parent="1" source="act4" target="act6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m16" value="16. activatePaidMembership() -&gt; INSERT INTO subscriptions" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.7917;entryX=0;entryY=0.0;" edge="1" parent="1" source="act6" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m17" value="17. Langganan Pro Aktif (Masa berlaku +30 hari)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8958;" edge="1" parent="1" source="act5" target="act6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m18" value="18. 200 OK (Webhook Acknowledged)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=1;exitY=1.0;entryX=0;entryY=0.5375;" edge="1" parent="1" source="act6" target="act9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m19" value="19. Polling Berkala: GET /qris/:id/status (Jalur B)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.7517;entryX=0;entryY=0.0;" edge="1" parent="1" source="fe" target="act8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m20" value="20. SELECT status, is_pro FROM transactions JOIN users" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3333;entryX=0;entryY=0.0;" edge="1" parent="1" source="act8" target="act7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m21" value="21. Data: status='success', is_pro=true" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.6667;" edge="1" parent="1" source="act7" target="act8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m22" value="22. 200 OK { status: 'success', message: 'Membership Pro Active' }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.8552;" edge="1" parent="1" source="act8" target="fe">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m23" value="23. BroadcastChannel.postMessage('MEMBERSHIP_UPDATED')" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.8897;entryX=0.5;entryY=0.9103;" edge="1" parent="1" source="fe" target="fe">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="380" y="1330"/><mxPoint x="380" y="1360"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m24" value="24. Tampilkan Faktur Sukses &amp; Buka Ruang Baca Kitab Pro" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0.5;exitY=0.9379;entryX=0.5;entryY=0.9379;" edge="1" parent="1" source="fe" target="u">
          <mxGeometry relative="1" as="geometry"/>
