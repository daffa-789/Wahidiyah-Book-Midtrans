{
  "title": "Sequence Diagram - QRIS Dual Path (Webhook + Polling)",
  "participants": [
    { "id": "u",   "label": "Pengguna (PWA)", "actor": true },
    { "id": "fe",  "label": "Klien Web (React 19)" },
    { "id": "be",  "label": "Backend API (Express)" },
    { "id": "mid", "label": "Midtrans Core API" },
    { "id": "db",  "label": "Supabase PostgreSQL" }
  ],
  "messages": [
    { "from": "u",  "to": "fe",  "label": "1. Pilih paket Pro & klik\n'Bayar QRIS'" },
    { "from": "fe", "to": "be",  "label": "2. POST /api/payments/\nqris/charge (JWT)" },
    { "from": "be", "to": "be",  "label": "3. Validasi Zod & generate\norder_id unik" },
    { "from": "be", "to": "mid", "label": "4. POST /v2/charge\n(payment_type: qris)" },
    { "from": "mid","to": "be",  "label": "5. 200 OK (qr_string,\nexpire_time 15m)", "return": true },
    { "from": "be", "to": "db",  "label": "6. INSERT transactions\n(status: pending)" },
    { "from": "db", "to": "be",  "label": "7. Baris tersimpan", "return": true },
    { "from": "be", "to": "fe",  "label": "8. 201 Created (qr_string,\norder_id, expires_at)", "return": true },
    { "from": "fe", "to": "u",   "label": "9. Render QR code &\ntimer hitung mundur", "return": true },
    { "from": "fe", "to": "be",  "label": "10. Polling GET /qris/\n:id/status (tiap 3s)", "async": true, "activate": false },
    { "from": "u",  "to": "mid", "label": "11. Pindai QRIS & transfer\ndana via e-wallet", "activate": false },
    { "note": "Dua jalur penyelesaian:\nWebhook (A) & Polling (B)", "over": "mid" },
    { "from": "mid","to": "be",  "label": "12. POST /midtrans/\nnotification (Jalur A)" },
    { "from": "be", "to": "be",  "label": "13. Verifikasi signature\nSHA-512 & timingSafeEqual" },
    { "from": "be", "to": "db",  "label": "14. CAS: UPDATE status=\nsuccess WHERE pending" },
    { "from": "db", "to": "be",  "label": "15. Rows affected = 1\n(klaim berhasil)", "return": true },
    { "from": "be", "to": "db",  "label": "16. activatePaidMembership()\nINSERT subscriptions" },
    { "from": "db", "to": "be",  "label": "17. Langganan Pro aktif\n(+30 hari)", "return": true },
    { "from": "be", "to": "mid", "label": "18. 200 OK (webhook\nacknowledged)", "return": true },
    { "from": "fe", "to": "be",  "label": "19. Polling berkala GET\n/qris/:id/status (Jalur B)" },
    { "from": "be", "to": "db",  "label": "20. SELECT status, is_pro\nFROM transactions" },
    { "from": "db", "to": "be",  "label": "21. status=success,\nis_pro=true", "return": true },
    { "from": "be", "to": "fe",  "label": "22. 200 OK (Membership\nPro Active)", "return": true },
    { "from": "fe", "to": "fe",  "label": "23. BroadcastChannel\npostMessage(UPDATED)" },
    { "from": "fe", "to": "u",   "label": "24. Tampilkan faktur &\nbuka ruang baca", "return": true }
  ]
}
