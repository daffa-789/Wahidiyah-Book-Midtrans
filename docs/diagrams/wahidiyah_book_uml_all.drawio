        </mxCell>
        <mxCell id="m0" value="1. Pilih Paket Pro &amp; Klik 'Bayar QRIS'" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0621;entryX=0;entryY=0.0;" edge="1" parent="1" source="u" target="act3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="2. POST /api/payments/qris/charge (JWT auth)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.119;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="3. Validasi Zod &amp; Generate order_id unik" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.1562;entryX=1;entryY=0.25;" edge="1" parent="1" source="act2" target="act2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="610" y="230" /><mxPoint x="610" y="260" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="4. POST /v2/charge (Server-Key, type: qris)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.375;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="5. 200 OK (qr_string, expire_time 15m)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.5312;" edge="1" parent="1" source="act0" target="act2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="6. INSERT INTO transactions (status: 'pending')" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6875;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="7. Transaksi Pending Tersimpan" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.8438;" edge="1" parent="1" source="act1" target="act2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="8. 201 Created { qr_string, order_id, expires_at }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.881;" edge="1" parent="1" source="act2" target="act3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="9. Render QR Code Interaktif &amp; Timer" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.3517;" edge="1" parent="1" source="act3" target="u">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="10. Polling Status: GET /qris/:id/status (loop 3s)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.3862;entryX=0;entryY=0.0;" edge="1" parent="1" source="fe" target="act6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="11. Scan QRIS &amp; Transfer Dana via E-Wallet" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4207;entryX=0;entryY=0.0;" edge="1" parent="1" source="u" target="act9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note11" value="Dua Jalur Penyelesaian: Webhook (A) dan Polling Otoritatif (B)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="680" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="12. POST /api/payments/midtrans/notification (Jalur A)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0;exitY=0.1375;entryX=1;entryY=0.3333;" edge="1" parent="1" source="act9" target="act6">
          <mxGeometry relative="1" as="geometry" />
