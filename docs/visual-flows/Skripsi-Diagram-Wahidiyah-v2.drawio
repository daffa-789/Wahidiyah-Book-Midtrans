ca;fontSize=10;fontColor=#495057;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1346" y="170" width="202" height="20" as="geometry"/></mxCell><mxCell id="02b-legend-swatch-69" value="" style="metaUml=legend-swatch;html=1;fillColor=#ffc9c9;strokeColor=#c92a2a;strokeWidth=1.5;shadow=0;glass=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1322" y="193" width="16" height="14" as="geometry"/></mxCell><mxCell id="02b-legend-text-70" value="notifikasi galat" style="metaUml=legend-text;text;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#495057;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1346" y="190" width="202" height="20" as="geometry"/></mxCell><mxCell id="02b-legend-swatch-71" value="" style="metaUml=legend-swatch;html=1;fillColor=#e9ecef;strokeColor=#495057;strokeWidth=1.5;shadow=0;glass=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1322" y="213" width="16" height="14" as="geometry"/></mxCell><mxCell id="02b-legend-text-72" value="merge — cabang bergabung ulang" style="metaUml=legend-text;text;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#495057;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1346" y="210" width="202" height="20" as="geometry"/></mxCell><mxCell id="02b-note-73" value="Fakta dari kode (server/lib/otp.js + otpStore.js) — nilai yang benar:&#10;• Masa berlaku OTP = 10 MENIT (OTP_TTL_MS).&#10;• Maksimum percobaan = 5 (guard `attempts &gt;= OTP_MAX_ATTEMPTS`).&#10;• Kode di-hash SHA-256 terikat ke (purpose, email, kode), sekali pakai;&#10;  kode lama dihapus saat kode baru diterbitkan.&#10;• Penyimpanan: tabel `email_verifications` (kolom `purpose` memisah&#10;  alur register &amp; reset). Tanpa kredensial Gmail → mode demo&#10;  (devOtp dikembalikan hanya bila NODE_ENV bukan production)." style="metaUml=note;shape=note;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10