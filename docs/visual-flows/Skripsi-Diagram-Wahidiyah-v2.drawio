1" parent="1"><mxGeometry x="331" y="988" width="250" height="16" as="geometry"/></mxCell><mxCell id="03b-fragment-guard-34" value="[else — gagal]" style="metaUml=fragment-guard;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fillColor=#ffffff;strokeColor=#495057;strokeWidth=2;shadow=0;glass=0;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="331" y="1005" width="250" height="16" as="geometry"/></mxCell><mxCell id="03b-fragment-sep-35" value="" style="metaUml=fragment-sep;html=1;endArrow=none;strokeColor=#495057;strokeWidth=1;shadow=0;glass=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="275" y="1005" width="1130" height="0" as="geometry"/></mxCell><mxCell id="03b-self-anchor-52" value="" style="metaUml=self-anchor;html=1;fillColor=none;strokeColor=none;opacity=0;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="397" y="1258" width="2" height="2" as="geometry"/></mxCell><mxCell id="03b-self-anchor-53" value="" style="metaUml=self-anchor;html=1;fillColor=none;strokeColor=none;opacity=0;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="397" y="1298" width="2" height="2" as="geometry"/></mxCell><mxCell id="03b-caption-55" value="Pembayaran langganan Pro via QRIS Simulator: transaksi QRIS dibuat &amp; dipantau (realtime Supabase + polling), lalu Pro diaktifkan oleh backend Express." style="metaUml=caption;text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#495057;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1450" width="1500" height="24" as="geometry"/></mxCell><mxCell id="03b-sync-msg-36" value="1. Memilih paket Pro &amp; metode bayar" style="metaUml=sync-msg;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1864ab;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-16" target="03b-lifeline-head-18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="330"/><mxPoint x="390" y="330"/></Array></mxGeometry></mxCell><mxCell id="03b-sync-msg-37" value="2. POST /api/transactions (buat transaksi QRIS)" style="metaUml=sync-msg;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1864ab;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-18" target="03b-lifeline-head-22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="388"/><mxPoint x="990" y="388"/></Array></mxGeometry></mxCell><mxCell id="03b-create-msg-38" value="3. INSERT qris_transactions (WAITING_PAYMENT)" style="metaUml=create-msg;html=1;endArrow=open;endFill=0;startArrow=none;strokeColor=#0c8599;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-22" target="03b-lifeline-head-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="446"/><mxPoint x="1290" y="446"/></Array></mxGeometry></mxCell><mxCell id="03b-reply-msg-39" value="4. { transaction_id, qr_payload }" style="metaUml=reply-msg;html=1;endArrow=open;endFill=0;startArrow=none;strokeColor=#868e96;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-22" target="03b-lifeline-head-18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="504"/><mxPoint x="390" y="504"/></Array></mxGeometry></mxCell><mxCell id="03b-reply-msg-40" value="5. Menampilkan QR &amp; tombol Simulasi Bayar" style="metaUml=reply-msg;html=1;endArrow=open;endFill=0;startArrow=none;strokeColor=#868e96;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-18" target="03b-lifeline-head-16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="562"/><mxPoint x="90" y="562"/></Array></mxGeometry></mxCell><mxCell id="03b-sync-msg-41" value="6. Pelunasan QR (scan / simulasi)" style="metaUml=sync-msg;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1864ab;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-16" target="03b-lifeline-head-22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="620"/><mxPoint x="990" y="620"/></Array></mxGeometry></mxCell><mxCell id="03b-sync-msg-42" value="7. UPDATE qris_transactions SET status = 'PAID'" style="metaUml=sync-msg;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1864ab;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-22" target="03b-lifeline-head-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="678"/><mxPoint x="1290" y="678"/></Array></mxGeometry></mxCell><mxCell id="03b-async-msg-43" value="8. Realtime: perubahan baris qris_transactions" style="metaUml=async-msg;html=1;endArrow=open;endFill=0;startArrow=none;strokeColor=#1864ab;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-24" target="03b-lifeline-head-18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="736"/><mxPoint x="390" y="736"/></Array></mxGeometry></mxCell><mxCell id="03b-sync-msg-44" value="9. Polling cadangan tiap 2 dtk (status transaksi)" style="metaUml=sync-msg;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1864ab;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-18" target="03b-lifeline-head-22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="794"/><mxPoint x="990" y="794"/></Array></mxGeometry></mxCell><mxCell id="03b-reply-msg-45" value="10. status = PAID" style="metaUml=reply-msg;html=1;endArrow=open;endFill=0;startArrow=none;strokeColor=#868e96;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-22" target="03b-lifeline-head-18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="852"/><mxPoint x="390" y="852"/></Array></mxGeometry></mxCell><mxCell id="03b-sync-msg-46" value="11. completePayment() → POST /api/transactions" style="metaUml=sync-msg;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1864ab;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-18" target="03b-lifeline-head-20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="910"/><mxPoint x="690" y="910"/></Array></mxGeometry></mxCell><mxCell id="03b-create-msg-47" value="12. INSERT transactions (status='success', ref_no)" style="metaUml=create-msg;html=1;endArrow=open;endFill=0;startArrow=none;strokeColor=#0c8599;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-20" target="03b-lifeline-head-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="968"/><mxPoint x="1290" y="968"/></Array></mxGeometry></mxCell><mxCell id="03b-create-msg-48" value="13. INSERT subscriptions (status='Aktif')" style="metaUml=create-msg;html=1;endArrow=open;endFill=0;startArrow=none;strokeColor=#0c8599;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-20" target="03b-lifeline-head-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="1026"/><mxPoint x="1290" y="1026"/></Array></mxGeometry></mxCell><mxCell id="03b-sync-msg-49" value="14. UPDATE users SET is_pro = true" style="metaUml=sync-msg;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1864ab;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-20" target="03b-lifeline-head-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="1084"/><mxPoint x="1290" y="1084"/></Array></mxGeometry></mxCell><mxCell id="03b-reply-msg-50" value="15. { transaction, subscription, user }" style="metaUml=reply-msg;html=1;endArrow=open;endFill=0;startArrow=none;strokeColor=#868e96;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-20" target="03b-lifeline-head-18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="1142"/><mxPoint x="390" y="1142"/></Array></mxGeometry></mxCell><mxCell id="03b-reply-msg-51" value="16. Layar Pembayaran Berhasil" style="metaUml=reply-msg;html=1;endArrow=open;endFill=0;startArrow=none;strokeColor=#868e96;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-lifeline-head-18" target="03b-lifeline-head-16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="1200"/><mxPoint x="90" y="1200"/></Array></mxGeometry></mxCell><mxCell id="03b-sync-msg-self-54" value="17. patchUser() — badge Pro diperbarui" style="metaUml=sync-msg;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1864ab;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03b-self-anchor-52" target="03b-self-anchor-53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="457" y="1258"/><mxPoint x="457" y="1298"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="03c" name="03C Sequence OTP Reset"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1622" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="03c-title-1" value="Diagram 03C Sequence OTP Reset" style="metaUml=title;text;html=1;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#212529;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1400" height="30" as="geometry"/></mxCell><mxCell id="03c-note-2" value="Kode di-hash SHA-256 terikat ke (purpose, email, kode); kedaluwarsa&#10;10 menit — server/lib/otp.js." style="metaUml=note;shape=note;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fillColor=#fff9db;strokeColor=#e67700;strokeWidth=1.5;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#212529;" vertex="1" parent="1"><mxGeometry x="60" y="62" width="380" height="84" as="geometry"/></mxCell><mxCell id="03c-note-3" value="Tanpa kredensial Gmail — mode demo: devOtp dikembalikan (hanya di luar&#10;produksi). Akun Google tidak diberi kode reset." style="metaUml=note;shape=note;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fillColor=#fff9db;strokeColor=#e67700;strokeWidth=1.5;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#212529;" vertex="1" parent="1"><mxGeomet