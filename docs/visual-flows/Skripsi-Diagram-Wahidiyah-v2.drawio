el, tablet, dan laptop; mudah diakses via tautan; tersimpan sebagai PWA dengan simpul luring sederhana." style="metaUml=box;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fillColor=#a5d8ff;strokeColor=#1971c2;strokeWidth=2;shadow=0;glass=0;verticalAlign=middle;align=left;spacingLeft=6;rounded=1;arcSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="224" width="640" height="108" as="geometry"/></mxCell><mxCell id="gc-box-13" value="WHAT — APA yang dibangun: Perpustakaan kitab digital, pembaca PDF vertikal, kalender agenda majelis, langganan Pro, portal administrator, iklan mandiri, autentikasi Google OAuth 2.0 dan pembayaran QRIS Simulator." style="metaUml=box;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fillColor=#e9ecef;strokeColor=#495057;strokeWidth=2;shadow=0;glass=0;verticalAlign=middle;align=left;spacingLeft=6;rounded=1;arcSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="352" width="640" height="108" as="geometry"/></mxCell><mxCell id="gc-gc-anchor-14" value="" style="metaUml=gc-anchor;html=1;fillColor=none;strokeColor=none;opacity=0;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="379" y="639" width="2" height="2" as="geometry"/></mxCell><mxCell id="gc-gc-anchor-15" value="" style="metaUml=gc-anchor;html=1;fillColor=none;strokeColor=none;opacity=0;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="379" y="519" width="2" height="2" as="geometry"/></mxCell><mxCell id="gc-callout-16" value="lingkaran terdalam = inti (WHY)" style="metaUml=callout;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fillColor=#a5d8ff;strokeColor=#1971c2;strokeWidth=2;shadow=0;glass=0;verticalAlign=middle;align=center;rounded=1;arcSize=14;" vertex="1" parent="1"><mxGeometry x="255" y="648" width="250" height="26" as="geometry"/></mxCell><mxCell id="gc-callout-17" value="panel penjelasan di kanan" style="metaUml=callout;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fillColor=#a5d8ff;strokeColor=#1971c2;strokeWidth=2;shadow=0;glas