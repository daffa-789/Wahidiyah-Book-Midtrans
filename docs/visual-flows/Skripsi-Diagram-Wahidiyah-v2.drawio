" parent="1"><mxGeometry x="989.5" y="258" width="1" height="1244" as="geometry"/></mxCell><mxCell id="03c-lifeline-head-24" value="Gmail API&#10;(HTTPS)" style="metaUml=lifeline-head;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#c3fae8;strokeColor=#0c8599;strokeWidth=2;shadow=0;glass=0;rounded=1;arcSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1195" y="210" width="190" height="48" as="geometry"/></mxCell><mxCell id="03c-lifeline-stem-25" value="" style="metaUml=lifeline-stem;html=1;endArrow=none;dashed=1;dashPattern=6 4;strokeColor=#0c8599;strokeWidth=1.5;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1289.5" y="258" width="1" height="1244" as="geometry"/></mxCell><mxCell id="03c-activation-26" value="" style="metaUml=activation;html=1;fillColor=#b2f2bb;strokeColor=#2f9e44;strokeWidth=1.5;shadow=0;glass=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="83" y="312" width="14" height="1146" as="geometry"/></mxCell><mxCell id="03c-activation-27" value="" style="metaUml=activation;html=1;fillColor=#a5d8ff;strokeColor=#1971c2;strokeWidth=1.5;shadow=0;glass=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="383" y="312" width="14" height="1146" as="geometry"/></mxCell><mxCell id="03c-activation-28" value="" style="metaUml=activation;html=1;fillColor=#a5d8ff;strokeColor=#1971c2;strokeWidth=1.5;shadow=0;glass=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="683" y="370" width="14" height="1030" as="geometry"/></mxCell><mxCell id="03c-activation-29" value="" style="metaUml=activation;html=1;fillColor=#d0bfff;strokeColor=#9c36b5;strokeWidth=1.5;shadow=0;glass=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="983" y="428" width="14" height="914" as="geometry"/></mxCell><mxCell id="03c-activation-30" value="" style="metaUml=activation;html=1;fillColor=#c3fae8;strokeColor=#0c8599;strokeWidth=1.5;shadow=0;glass=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1283" y="718" width="14" height="102" as="geometry"/></mxCell><mxCell id="03c-fragment-31" value="" style="metaUml=fragment;html=1;fillColor=none;strokeColor=#495057;strokeWidth=1.5;shadow=0;glass=0;rounded=0;dashed=0;" vertex="1" parent="1"><mxGeometry x="275" y="348" width="530" height="534" as="geometry"/></mxCell><mxCell id="03c-fragment-tab-32" value="alt" style="metaUml=fragment-tab;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#495057;strokeWidth=1.5;fontSize=10;fontStyle=1;fontFamily=Helvetica;fontColor=#212529;rounded=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="275" y="348" width="46" height="20" as="geometry"/></mxCell><mxCell id="03c-fragment-guard-33" value="[kirim ulang — maks. 5 percobaan]" style="metaUml=fragment-guard;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fillColor=#ffffff;strokeColor=#495057;strokeWidth=2;shadow=0;glass=0;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="331" y="350" width="250" height="16" as="geometry"/></mxCell><mxCell id="03c-self-anchor-38" value="" style="metaUml=self-anchor;html=1;fillColor=none;strokeColor=none;opacity=0;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="697" y="562" width="2" height="2" as="geometry"/></mxCell><mxCell id="03c-self-anchor-39" value="" style="metaUml=self-anchor;html=1;fillColor=none;strokeColor=none;opacity=0;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="697" y="602" width="2" height="2" as="geometry"/></mxCell><mxCell id="03c-self-anchor-51" value="" style="metaUml=self-anchor;html=1;fillColor=none;strokeColor=none;opacity=0;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="697" y="1200" width="2" height="2" as="geometry"/></mxCell><mxCell id="03c-self-anchor-52" value="" style="metaUml=self-anchor;html=1;fillColor=none;strokeColor=none;opacity=0;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="697" y="1240" width="2" height="2" as="geometry"/></mxCell><mxCell id="03c-caption-58" value="Pemulihan password berbasis OTP server-side (SHA-256 terikat email+tujuan, kedaluwarsa 10 menit, maksimum 5 percobaan, sekali pakai)." style="metaUml=caption;text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#495057;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1584" width="1500" height="24" as="geometry"/></mxCell><mxCell id="03c-sync-msg-34" value="1. Buka Lupa Password &amp; isi email" style="metaUml=sync-msg;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1864ab;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03c-lifeline-head-16" target="03c-lifeline-head-18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="330"/><mxPoint x="390" y="330"/></Array></mxGeometry></mxCell><mxCell id="03c-sync-msg-35" value="2. POST /api/auth/request-password-reset" style="metaUml=sync-msg;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1864ab;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03c-lifeline-head-18" target="03c-lifeline-head-20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="388"/><mxPoint x="690" y="388"/></Array></mxGeometry></mxCell><mxCell id="03c-sync-msg-36" value="3. SELECT users WHERE email = ?" style="metaUml=sync-msg;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1864ab;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;rounded=0;shadow=0;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="03c-lifeline-head-20" target="03c-lifeline-head-22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="446"/><mxPoint x="990" y="446"/></Array></mxGeometry></mxCell><mxCell id="03c-reply-msg-37" value="4. baris / kosong (respons selalu sama)" style="metaUml=reply-msg;html=1;endArrow=open;endFill=0;startArrow=n