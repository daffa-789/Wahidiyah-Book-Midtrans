        <mxCell id="r59-a-note" value="Registrasi memakai pola OTP berlapis: kode 6 digit hanya berlaku 10 menit dan dibatasi 5 kali salah. Akun baru dibuat (INSERT) baru setelah kode terbukti sah — status akun dianggap aktif sejak dibuat.

[validasi Zod] memblokir input sebelum menyentuh basis data, sehingga query email terdaftar adalah satu-satunya akses DB pada jalur galat." style="metaUml=note;shape=note;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fillColor=#fff9db;strokeColor=#e67700;strokeWidth=1.5;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="1340" y="272" width="560" height="152" as="geometry" />
        </mxCell>
        <mxCell id="r59-a-caption" value="Alur registrasi akun (email + kata sandi). Aktor: Jamaah. Kode OTP dikirim via Gmail API dan diverifikasi lewat email_verifications sebelum baris users dibuat." style="metaUml=caption;text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#495057;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="1732" width="1500" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
