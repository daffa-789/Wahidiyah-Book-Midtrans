    "dev:server": "node --watch server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/server.js",
    "server:dev": "node --watch server/server.js",
    "check": "node --check server/server.js && vite build",
    "health": "node scripts/health-check.js",
    "clean:ports": "node scripts/clean-ports.js",
    "gmail:token": "node scripts/get-gmail-token.js",
    "audit:security": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@supabase/supabase-js": "^2.117.2",
    "@vitejs/plugin-react": "^4.3.4",
