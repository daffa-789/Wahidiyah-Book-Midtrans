# ─────────────────────────────────────────────────────────────
# Contoh konfigurasi lingkungan — salin ke .env lalu isi nilainya.
# Ambil kunci di https://dashboard.sandbox.midtrans.com → Settings → Access Keys
# GUNAKAN KUNCI SANDBOX (berawalan SB-Mid-…) untuk pengujian.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
VITE_PORT=3000

# ── Midtrans (Core API QRIS) ────────────────────────────────
# Server Key RAHASIA — jangan pernah taruh di frontend atau commit ke Git.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# false = sandbox (api.sandbox.midtrans.com), true = production
MIDTRANS_IS_PRODUCTION=false

# Akuisisi QRIS: "gopay" (default) atau "airpay shopee"
MIDTRANS_QRIS_ACQUIRER=gopay

# Masa berlaku QR dalam menit (minimal 15)
MIDTRANS_QRIS_EXPIRY_MINUTES=15

# ── Web Push Notification (pengingat agenda H-1) ─────────────
# Buat pasangan kunci sekali:  node scripts/generate-vapid-keys.js
# Kunci privat RAHASIA — jangan commit .env. Bila kunci diganti, semua
# perangkat harus mengaktifkan notifikasi ulang.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Kontak pengelola — wajib berawalan mailto: atau berupa URL https://.
# Dipakai push service untuk menghubungi Anda bila ada masalah pengiriman.
VAPID_SUBJECT=mailto:admin@example.com

# Jam pengiriman pengingat dalam WIB (format HH:MM).
PUSH_REMINDER_HOUR=08:00
